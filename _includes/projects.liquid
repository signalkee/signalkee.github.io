<div class="col">
  {% if project.demo_featured %}
    <article class="project-card-v2 v2-demo-card">
  {% else %}
    <a class="project-card-v2" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
  {% endif %}
  {% if project.thumb_video %}
    <div class="project-card-v2-media">
      <video autoplay muted loop playsinline poster="{{ project.thumb_poster | relative_url }}" aria-label="{{ project.title }} preview">
        <source src="{{ project.thumb_video | relative_url }}" type="video/mp4">
      </video>
    </div>
  {% elsif project.img %}
    <div class="project-card-v2-media">
      <img src="{{ project.img | relative_url }}" alt="{{ project.title }} preview" loading="lazy">
    </div>
  {% else %}
    <div class="project-card-v2-media project-card-v2-fallback" aria-hidden="true">
      <span>{{ project.cover_label | default: project.title | slice: 0, 8 | upcase }}</span>
    </div>
  {% endif %}
  <div class="project-card-v2-body">
    <p class="v2-card-meta">
      {{ project.kicker | default: project.category -}}
      {%- if project.demo_featured %}
        <span class="v2-demo-badge">Live Web Demo</span>
      {%- endif %}
    </p>
    <h3>{{ project.title }}</h3>
    <p>{{ project.description }}</p>
    {% if project.demo_featured %}
      <div class="v2-actions v2-demo-card-actions">
        <a class="v2-text-link" href="{{ project.url | relative_url }}">Project page →</a>
        <a class="v2-text-link" href="{{ project.paper }}" target="_blank" rel="noopener">Paper ↗</a>
        <a class="v2-btn v2-btn-primary" href="{{ project.demo }}" target="_blank" rel="noopener">Live Demo ↗</a>
      </div>
    {% else -%}
      <span class="v2-card-cta">Open project →</span>
    {%- endif %}
  </div>
  {% if project.demo_featured %}</article>{% else %}</a>{% endif %}
</div>
