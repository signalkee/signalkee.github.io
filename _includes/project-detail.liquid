<div class="project-v2">
  <a class="v2-back-link" href="{{ '/Researches & Projects/' | relative_url }}">← Research</a>

  <header class="project-v2-hero{% if page.hide_hero_image %} project-v2-hero-text{% endif %}">
    <div class="project-v2-copy">
      <p class="v2-eyebrow">{{ page.kicker | default: page.category | default: 'PROJECT' }}</p>
      <h1>{{ page.title }}</h1>
      {% if page.description %}
        <p class="project-v2-deck">{{ page.description }}</p>
      {% endif %}

      {% if page.venue or page.year or page.role %}
        <div class="project-v2-meta">
          {% if page.venue -%}
            <span>{{ page.venue }}</span>
          {%- endif %}
          {% if page.year -%}
            <span>{{ page.year }}</span>
          {%- endif %}
          {% if page.role -%}
            <span>{{ page.role }}</span>
          {%- endif %}
        </div>
      {% endif %}

      {% if page.paper or page.arxiv or page.code or page.video or page.project_url or page.demo %}
        <div class="v2-actions project-v2-actions">
          {% if page.paper -%}
            <a class="v2-btn v2-btn-primary" href="{{ page.paper }}" target="_blank" rel="noopener">Paper ↗</a>
          {%- endif %}
          {% if page.arxiv -%}
            <a class="v2-btn" href="{{ page.arxiv }}" target="_blank" rel="noopener">arXiv ↗</a>
          {%- endif %}
          {% if page.demo -%}
            <a class="v2-btn" href="{{ page.demo }}" target="_blank" rel="noopener">Live Demo ↗</a>
          {%- endif %}
          {% if page.code -%}
            <a class="v2-btn" href="{{ page.code }}" target="_blank" rel="noopener">Code ↗</a>
          {%- endif %}
          {% if page.video -%}
            <a class="v2-btn" href="{{ page.video }}" target="_blank" rel="noopener">Video ↗</a>
          {%- endif %}
          {% if page.project_url -%}
            <a class="v2-btn" href="{{ page.project_url }}" target="_blank" rel="noopener">Project ↗</a>
          {%- endif %}
        </div>
      {% endif %}
    </div>

    {% unless page.hide_hero_image %}
      {% if page.img %}
        <figure class="project-v2-cover">
          <img src="{{ page.img | relative_url }}" alt="{{ page.title }} preview" loading="eager">
        </figure>
      {% else %}
        <div class="project-v2-cover project-v2-cover-fallback" aria-hidden="true">
          <span>{{ page.cover_label | default: page.title | slice: 0, 8 | upcase }}</span>
        </div>
      {% endif %}
    {% endunless %}
  </header>

  {% if page.results_overview %}
    {% include acdc-results-overview.liquid %}
  {% endif %}

  {% if page.demo_preview %}
    <section class="project-demo-v2" aria-labelledby="interactive-demo-title">
      <a
        class="project-demo-v2-preview"
        href="{{ page.demo }}"
        target="_blank"
        rel="noopener"
        aria-label="Try the AC-DC guided demo (opens in a new tab)"
      >
        <img
          src="{{ page.demo_preview | relative_url }}"
          width="1366"
          height="768"
          loading="lazy"
          alt="AC-DC tutorial: a robot map alongside What, When, and Whom; R13 is chosen while R10 is being reviewed."
        >
      </a>
      <div class="project-demo-v2-copy">
        <h2 id="interactive-demo-title">Interactive Demo</h2>
        <p>How does AC-DC choose who to contact, when to communicate, and what to share? Follow one exchange.</p>
        <div class="v2-actions">
          <a class="v2-btn v2-btn-primary" href="{{ page.demo }}" target="_blank" rel="noopener">Try the guided demo ↗</a>
          <a class="v2-text-link" href="{{ page.demo_explore }}" target="_blank" rel="noopener">Open playground ↗</a>
        </div>
      </div>
    </section>
  {% endif %}

  <article class="project-v2-body">
    {{ include.content }}
  </article>
</div>
