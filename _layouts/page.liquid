---
layout: default
---
{% if page.collection == 'projects' %}
  {% include project-detail.liquid content=content %}
{% else %}
  <div class="post v2-standard-page">
    <header class="post-header v2-page-header">
      <p class="v2-eyebrow">{{ page.eyebrow | default: page.title }}</p>
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>
    <article>{{ content }}</article>
  </div>
{% endif %}
